# Playwright E2E test variables.
# Consumed by playwright.config.ts and test fixtures via process.env
# (TEST_ENV, STAGING_URL, PRODUCTION_URL, ...).
# Provide them through your shell/CI environment, or export from a file
# before running `npm run test:e2e`. Kept separate from the app's Vite env
# (.env.local) since these are test-only values.

# Test Environment: local | staging | production
TEST_ENV=local

# Test user credentials (authenticated tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=test_password_123

# Admin user credentials (admin tests)
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=admin_password_123

# Environment URLs (used when TEST_ENV is staging/production)
STAGING_URL=https://staging.vngeo.example.com
PRODUCTION_URL=https://vngeo.example.com

# Optional: service account for API-only tests
SERVICE_API_KEY=your_service_api_key_here
INTERNAL_SERVICE_URL=http://localhost:3001

# =============================================================================
# CRUD (write-path) E2E tests — gated additions (CRUD_TEST_SPEC.md §6).
# These are OFF by default so the green read-suite never depends on write
# access. Set TEST_RUN_CRUD_WRITE=1 to opt in. The *-crud.spec.ts suites +
# teardown are skipped while it is unset or 0.
# =============================================================================

# Local Supabase REST endpoint used by the service-role teardown client
# (NOT the Vite-prefixed app vars). Must match the LOCAL stack.
SUPABASE_URL=http://localhost:8000

# LOCAL-ONLY service-role key (from supabase/.env). Bypasses RLS for teardown.
# NEVER commit a cloud service-role key here, and NEVER reuse this against cloud.
# Copy the value from supabase/.env after running supabase/setup-local-supabase.sh.
SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key_here

# Master switch for CRUD write tests. 1 = enabled (requires the two vars above
# AND the app pointed at LOCAL Supabase via .env.local). Unset/0 = skip cleanly.
TEST_RUN_CRUD_WRITE=0
