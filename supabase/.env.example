# Local Supabase Development Environment Variables
# Docker Compose auto-loads .env from this directory (run 'docker compose' from supabase/).
# Copy to .env and fill in values, or run setup-local-supabase.sh to generate them.
# Frontend/Vite variables live in the repo-root .env.local, NOT here.

# Database
POSTGRES_PASSWORD=your_secure_password_here

# JWT & Keys
JWT_SECRET=your_jwt_secret_min_32_characters
SECRET_KEY_BASE=your_secret_key_base_min_32_characters
ANON_KEY=your_anon_key_here
SERVICE_ROLE_KEY=your_service_role_key_here
PG_META_CRYPTO_KEY=your_pg_meta_crypto_key
# 16-byte hex key for Realtime AES-128-ECB tenant-secret encryption (openssl rand -hex 8)
REALTIME_DB_ENC_KEY=your_realtime_db_enc_key

# URLs
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=

# SMTP (Email) - Configure for local development or use mailhog
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Supabase

# Mailer URL Paths
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# Kong
KONG_HTTP_PORT=8000

# Studio
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=your_password_here
